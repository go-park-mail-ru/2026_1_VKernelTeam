erDiagram
    user ||--o{ product : "creates"
    user ||--o{ review : "writes_receives"
    user ||--o{ favorite : "adds_to"
    user ||--o{ cart_item : "adds_to_cart"
    user ||--o{ chat : "participates"
    user ||--o{ message : "sends"

    category ||--o{ product : "contains"
    category ||--o{ category : "parent_of"

    product ||--o{ product_image : "has"
    product ||--o{ favorite : "is_in"
    product ||--o{ review : "is_about"
    product ||--o{ product_price_history : "has"
    product ||--o{ product_status_history : "has"
    product ||--o{ cart_item : "is_in"
    product ||--o{ chat : "discussed_in"

