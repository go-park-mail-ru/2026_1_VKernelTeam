    user {
        bigint id PK
        text email UK
        text password_hash
        text first_name
        text second_name
        text avatar_url
        numeric rating
        timestamp created_at
        timestamp updated_at
    }

    product {
        bigint id PK
        bigint seller_id FK
        bigint category_id FK
        text title
        text description
        bigint price
        text status
        bigint views_count
        bigint favorites_count
        timestamp created_at
        timestamp updated_at
        timestamp deleted_at
    }

    product_price_history {
        bigint id PK
        bigint product_id FK
        bigint old_price
        bigint new_price
        timestamp created_at
        timestamp updated_at
    }

    product_status_history {
        bigint id PK
        bigint product_id FK
        text old_status
        text new_status
        timestamp created_at
        timestamp updated_at
    }

    category {
        bigint id PK
        text name UK
        bigint parent_id FK
        timestamp created_at
        timestamp updated_at
    }

    product_image {
        bigint id PK
        bigint product_id FK
        text url
        boolean is_main
        timestamp created_at
        timestamp updated_at
    }

    favorite {
        bigint user_id PK_FK
        bigint product_id PK_FK
        timestamp created_at
        timestamp updated_at
    }

    cart_item {
        bigint user_id PK_FK
        bigint product_id PK_FK
        timestamp created_at
        timestamp updated_at
    }

    review {
        bigint id PK
        bigint sender_id FK
        bigint receiver_id FK
        bigint product_id FK
        integer rating
        text content
        timestamp created_at
        timestamp updated_at
    }

    chat {
        bigint id PK
        bigint product_id FK
        bigint buyer_id FK
        bigint seller_id FK
        timestamp created_at
        timestamp updated_at
    }

    message {
        bigint id PK
        bigint chat_id FK
        bigint sender_id FK
        text text_content
        boolean is_read
        timestamp created_at
        timestamp updated_at
    }
