# ─── Общее ────────────────────────────────────────────────────
TOKEN_SECRET="your-secret-key"

# ─── S3 (общее хранилище) ─────────────────────────────────────
S3_ENDPOINT_URL=https://hb.vkcs.cloud
S3_REGION_NAME=ru-msk
S3_BUCKET_NAME=my-app-media
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key

# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=clover
POSTGRES_PORT=8010

# ─── Redis ────────────────────────────────────────────────────
REDIS_ADDR=redis:6379
REDIS_PORT=8011

# ─── Kafka ────────────────────────────────────────────────────
KAFKA_PORT=8012

# ─── Порты сервисов (внешние) ─────────────────────────────────
GATEWAY_PORT=8080
MONOLITH_PORT=8000
AUTH_HTTP_PORT=8001
SUPPORT_HTTP_PORT=8002
AUTH_GRPC_PORT=8003
CATALOG_HTTP_PORT=8004
CATALOG_GRPC_PORT=8005
COMMERCE_HTTP_PORT=8006

# ─── ClickHouse ──────────────────────────────────────────────
CLICKHOUSE_PORT=8020
CLICKHOUSE_NATIVE_PORT=8021
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=logs

# ─── Grafana ─────────────────────────────────────────────────
GRAFANA_PORT=8031
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ─── Prometheus ──────────────────────────────────────────────
PROMETHEUS_PORT=8030
