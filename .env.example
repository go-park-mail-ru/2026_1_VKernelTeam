# ─── Общее ────────────────────────────────────────────────────
TOKEN_SECRET="your-secret-key"

# ─── S3 (общее хранилище) ─────────────────────────────────────
S3_ENDPOINT_URL=https://hb.vkcs.cloud
S3_REGION_NAME=ru-msk
S3_BUCKET_NAME=my-app-media
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key

# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=clover
POSTGRES_PORT=8010

# ─── Redis ────────────────────────────────────────────────────
REDIS_ADDR=redis:6379
REDIS_PORT=8011

# ─── Kafka ────────────────────────────────────────────────────
KAFKA_PORT=8012

# ─── Порты сервисов (внешние) ─────────────────────────────────
GATEWAY_PORT=80
GATEWAY_HTTPS_PORT=443
AUTH_HTTP_PORT=8001
SUPPORT_HTTP_PORT=8002
AUTH_GRPC_PORT=8003
CATALOG_HTTP_PORT=8004
CATALOG_GRPC_PORT=8005
COMMERCE_HTTP_PORT=8006

# ─── Фронтенд ─────────────────────────────────────────────────
# Папка, которую gateway-nginx раздаёт как статику фронтенда.
# Прод: `make deploy` во фронт-репозитории кладёт сюда собранный dist/ (rsync).
# Dev: можно указать прямой путь к dist/ соседнего репозитория, чтобы пересборка
#   автоматически подхватывалась контейнером — например:
#   FRONTEND_DIST_PATH=../../2026_1_VKernel_Team/dist
FRONTEND_DIST_PATH=/var/www/clover

# ─── ClickHouse ──────────────────────────────────────────────
CLICKHOUSE_PORT=8020
CLICKHOUSE_NATIVE_PORT=8021
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=logs

# ─── Grafana ─────────────────────────────────────────────────
GRAFANA_PORT=8031
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ─── Prometheus ──────────────────────────────────────────────
# Порт наружу не публикуется — Prometheus доступен через nginx:
# https://clover-go.ru/prometheus/. См. deployments/docker-compose.yaml.

# ─── ЮКасса (платежи) ────────────────────────────────────────
# Когда YOOKASSA_ENABLED=false — commerce использует mock-провайдера, который
# мгновенно возвращает succeeded (для dev-окружения без боевых ключей).
YOOKASSA_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_URL=https://api.yookassa.ru/v3
YOOKASSA_RETURN_URL=https://clover-go.ru/wallet?topup=done
