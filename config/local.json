{
  "env": "prod",
  "token_ttl": "15m",
  "refresh_ttl": "168h",
  "http": {
    "port": 8000
  },
  "cleanup_interval": "5m",
  "views": {
    "dedup_ttl": "24h",
    "stream_key": "views:events",
    "consumer_group": "views-consumer",
    "batch_size": 100,
    "flush_interval": "2s",
    "block_timeout": "1s",
    "count_cache_ttl": "48h",
    "claim_timeout": "30s"
  }
}
