<clickhouse>
    <text_log remove="remove">1</text_log>
    <trace_log remove="remove">1</trace_log>
    <processors_profile_log remove="remove">1</processors_profile_log>
    <error_log remove="remove">1</error_log>
    <query_metric_log remove="remove">1</query_metric_log>
    <part_log remove="remove">1</part_log>

    <metric_log>
        <database>system</database>
        <table>metric_log</table>
        <flush_interval_milliseconds>60000</flush_interval_milliseconds>
        <collect_interval_milliseconds>10000</collect_interval_milliseconds>
        <max_size_rows>1048576</max_size_rows>
        <reserved_size_rows>8192</reserved_size_rows>
        <buffer_size_rows_flush_threshold>524288</buffer_size_rows_flush_threshold>
        <engine>
            ENGINE = MergeTree
            PARTITION BY toYYYYMM(event_date)
            ORDER BY (event_date, event_time)
            TTL event_date + INTERVAL 3 DAY DELETE
            SETTINGS ttl_only_drop_parts=1
        </engine>
    </metric_log>

    <asynchronous_metric_log>
        <database>system</database>
        <table>asynchronous_metric_log</table>
        <flush_interval_milliseconds>60000</flush_interval_milliseconds>
        <max_size_rows>1048576</max_size_rows>
        <engine>
            ENGINE = MergeTree
            PARTITION BY toYYYYMM(event_date)
            ORDER BY (event_date, event_time)
            TTL event_date + INTERVAL 3 DAY DELETE
            SETTINGS ttl_only_drop_parts=1
        </engine>
    </asynchronous_metric_log>

    <query_log>
        <database>system</database>
        <table>query_log</table>
        <flush_interval_milliseconds>30000</flush_interval_milliseconds>
        <max_size_rows>1048576</max_size_rows>
        <engine>
            ENGINE = MergeTree
            PARTITION BY toYYYYMM(event_date)
            ORDER BY (event_date, event_time)
            TTL event_date + INTERVAL 7 DAY DELETE
            SETTINGS ttl_only_drop_parts=1
        </engine>
    </query_log>

    <query_thread_log remove="remove">1</query_thread_log>
    <query_views_log remove="remove">1</query_views_log>
    <opentelemetry_span_log remove="remove">1</opentelemetry_span_log>
    <crash_log remove="remove">1</crash_log>
    <session_log remove="remove">1</session_log>
    <backup_log remove="remove">1</backup_log>
    <blob_storage_log remove="remove">1</blob_storage_log>
    <zookeeper_log remove="remove">1</zookeeper_log>
    <s3queue_log remove="remove">1</s3queue_log>
</clickhouse>
