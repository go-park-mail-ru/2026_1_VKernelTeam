{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "title": "Clover · auth",
  "uid": "clover-auth",
  "tags": ["clover", "service", "auth"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "links": [
    { "title": "Overview", "type": "link", "url": "/d/clover-overview", "icon": "dashboard", "targetBlank": false, "keepTime": true },
    { "title": "Other services", "type": "dashboards", "tags": ["service"], "asDropdown": true, "includeVars": false, "keepTime": true, "targetBlank": false }
  ],
  "templating": {
    "list": [
      {
        "name": "service", "type": "constant", "label": "service",
        "current": { "text": "auth", "value": "auth" },
        "query": "auth", "hide": 2
      },
      {
        "name": "job", "type": "constant", "label": "job",
        "current": { "text": "auth", "value": "auth" },
        "query": "auth", "hide": 2
      }
    ]
  },
  "panels": [
    {
      "type": "row", "id": 1, "title": "Health", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2, "type": "stat", "title": "Status",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": {
              "0": { "text": "DOWN", "color": "red", "index": 0 },
              "1": { "text": "UP",   "color": "green", "index": 1 }
            }}
          ],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "green", "value": 1 }
          ]},
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "graphMode": "none", "colorMode": "background", "textMode": "value" },
      "targets": [
        { "expr": "up{job=\"$job\"}", "refId": "A", "instant": true }
      ]
    },
    {
      "id": 3, "type": "stat", "title": "RPS (1m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "options": { "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "expr": "sum(rate(http_requests_total{service=\"$service\"}[1m]))", "refId": "A" }
      ]
    },
    {
      "id": 4, "type": "stat", "title": "5xx ratio (5m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.01 },
            { "color": "red", "value": 0.05 }
          ]}
        }
      },
      "options": { "colorMode": "background", "graphMode": "area" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{service=\"$service\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{service=\"$service\"}[5m])), 1)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row", "id": 5, "title": "HTTP", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },
    {
      "id": 6, "type": "timeseries", "title": "RPS by path",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by(path) (rate(http_requests_total{service=\"$service\"}[1m]))",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7, "type": "timeseries", "title": "5xx by path",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by(path) (rate(http_requests_total{service=\"$service\",status=~\"5..\"}[5m]))",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8, "type": "timeseries", "title": "Latency p50 / p95 / p99",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 5 }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by(le) (rate(http_request_duration_seconds_bucket{service=\"$service\"}[5m])))",
          "legendFormat": "p50", "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by(le) (rate(http_request_duration_seconds_bucket{service=\"$service\"}[5m])))",
          "legendFormat": "p95", "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by(le) (rate(http_request_duration_seconds_bucket{service=\"$service\"}[5m])))",
          "legendFormat": "p99", "refId": "C"
        }
      ]
    },
    {
      "id": 9, "type": "table", "title": "Top-10 slowest endpoints (p95, 5m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "topk(10, histogram_quantile(0.95, sum by(path, le) (rate(http_request_duration_seconds_bucket{service=\"$service\"}[5m]))))",
          "legendFormat": "{{path}}",
          "format": "table", "instant": true, "refId": "A"
        }
      ]
    },
    {
      "type": "row", "id": 10, "title": "gRPC", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 }
    },
    {
      "id": 11, "type": "timeseries", "title": "gRPC RPS by method",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 23 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "expr": "sum by(grpc_method) (rate(grpc_server_handled_total{service=\"$service\"}[1m]))",
          "legendFormat": "{{grpc_method}}", "refId": "A"
        }
      ]
    },
    {
      "id": 12, "type": "timeseries", "title": "gRPC errors (non-OK)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 23 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "expr": "sum by(grpc_method, grpc_code) (rate(grpc_server_handled_total{service=\"$service\",grpc_code!=\"OK\"}[5m]))",
          "legendFormat": "{{grpc_method}} {{grpc_code}}", "refId": "A"
        }
      ]
    },
    {
      "id": 13, "type": "timeseries", "title": "gRPC latency p95",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 23 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 5 }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(grpc_method, le) (rate(grpc_server_handling_seconds_bucket{service=\"$service\"}[5m])))",
          "legendFormat": "{{grpc_method}}", "refId": "A"
        }
      ]
    },
    {
      "type": "row", "id": 14, "title": "Gateway view (nginx → this service)", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 }
    },
    {
      "id": 15, "type": "timeseries", "title": "Gateway 5xx hitting $service",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "rawSql": "SELECT $__timeInterval(timestamp) AS t, toString(status) AS series, count() AS c FROM logs.gateway_access WHERE $__timeFilter(timestamp) AND upstream = '${service}_service' AND status >= 500 GROUP BY t, series ORDER BY t",
          "format": 0
        }
      ]
    },
    {
      "id": 16, "type": "timeseries", "title": "Upstream response time p95 ($service)",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 5 }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "rawSql": "SELECT $__timeInterval(timestamp) AS t, quantile(0.95)(upstream_response_time) AS p95 FROM logs.gateway_access WHERE $__timeFilter(timestamp) AND upstream = '${service}_service' GROUP BY t ORDER BY t",
          "format": 0
        }
      ]
    },
    {
      "type": "row", "id": 17, "title": "Logs", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 }
    },
    {
      "id": 18, "type": "logs", "title": "Recent errors / warnings",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 41 },
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "rawSql": "SELECT timestamp AS time, level, message, request_id FROM logs.service_logs WHERE $__timeFilter(timestamp) AND service = '$service' AND level IN ('error','warn') ORDER BY timestamp DESC LIMIT 200",
          "format": 1
        }
      ]
    },
    {
      "id": 19, "type": "logs", "title": "All logs",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 51 },
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "rawSql": "SELECT timestamp AS time, level, message, request_id FROM logs.service_logs WHERE $__timeFilter(timestamp) AND service = '$service' ORDER BY timestamp DESC LIMIT 500",
          "format": 1
        }
      ]
    }
  ]
}
