# run по умолчанию, чтобы можно было запускать просто командой make
.DEFAULT_GOAL := run

# запуск проекта
run:
	go run cmd/server/main.go

# запуск тестов с отображением покрытия
test:
	go test -cover ./internal/...

# очистка (например, если появятся временные файлы или скомпилированные бинарники)
clean:
	go clean
