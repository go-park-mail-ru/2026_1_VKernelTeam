{
	"info": {
		"name": "Clover API",
		"description": "API маркетплейса Клевер.\n\nАрхитектура: API Gateway (nginx :8080) → микросервисы.\n\n- Auth Service (:8001 HTTP, :8003 gRPC)\n- Support Service (:8002 HTTP)\n- Монолит (:8000) — ads, cart, chat\n\nПеременные:\n- `gateway` — через nginx (http://localhost:8080)\n- `authDirect` — напрямую к auth (http://localhost:8001)\n- `supportDirect` — напрямую к support (http://localhost:8002)\n- `monolithDirect` — напрямую к монолиту (http://localhost:8000)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "gateway",
			"value": "http://localhost:8080/api/v1",
			"description": "Через API Gateway (nginx)"
		},
		{
			"key": "authDirect",
			"value": "http://localhost:8001/api/v1",
			"description": "Напрямую к Auth Service"
		},
		{
			"key": "supportDirect",
			"value": "http://localhost:8002/api/v1",
			"description": "Напрямую к Support Service"
		},
		{
			"key": "monolithDirect",
			"value": "http://localhost:8000/api/v1",
			"description": "Напрямую к монолиту"
		},
		{
			"key": "baseUrl",
			"value": "http://localhost:8080/api/v1",
			"description": "Активный URL (по умолчанию — gateway)"
		},
		{
			"key": "adId",
			"value": "1"
		},
		{
			"key": "userId",
			"value": "1"
		},
		{
			"key": "categoryId",
			"value": "1"
		},
		{
			"key": "productId",
			"value": "1"
		},
		{
			"key": "chatId",
			"value": "1"
		},
		{
			"key": "ticketId",
			"value": "1"
		}
	],
	"event": [
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Автоматически сохраняем CSRF токен из cookie после любого запроса",
					"const csrf = pm.cookies.get('csrf_token');",
					"if (csrf) {",
					"    pm.collectionVariables.set('csrfToken', csrf);",
					"}"
				]
			}
		}
	],
	"item": [
		{
			"name": "Auth Service",
			"description": "Микросервис авторизации (services/auth).\nРоуты: /auth/*, /profile*, /users/{id}",
			"item": [
				{
					"name": "Register",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 200) {",
									"    const body = pm.response.json();",
									"    pm.collectionVariables.set('userId', body.user_id);",
									"    pm.test('User registered', () => {",
									"        pm.expect(body.user_id).to.be.above(0);",
									"        pm.expect(body.email).to.be.a('string');",
									"    });",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Test1234!\",\n  \"name\": \"Иван\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "register"]
						},
						"description": "Регистрация + автоматический логин. Устанавливает cookie: token, csrf_token, refresh_token."
					}
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 200) {",
									"    const body = pm.response.json();",
									"    pm.collectionVariables.set('userId', body.user_id);",
									"    pm.test('Login successful', () => {",
									"        pm.expect(body.user_id).to.be.above(0);",
									"    });",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Test1234!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "Login (by cookie)",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						},
						"description": "Если cookie token уже есть — валидирует токен и возвращает профиль без body."
					}
				},
				{
					"name": "Refresh Token",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/auth/refresh",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "refresh"]
						},
						"description": "Обновление access token по refresh token из cookie. Ротирует оба токена."
					}
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [
							{"key": "X-CSRF-Token", "value": "{{csrfToken}}"}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/logout",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "logout"]
						},
						"description": "Добавляет JWT в blacklist, удаляет refresh token, очищает cookie."
					}
				},
				{
					"name": "Get My Profile",
					"request": {
						"method": "GET",
						"header": [
							{"key": "X-CSRF-Token", "value": "{{csrfToken}}"}
						],
						"url": {
							"raw": "{{baseUrl}}/profile",
							"host": ["{{baseUrl}}"],
							"path": ["profile"]
						},
						"description": "Профиль текущего пользователя (по JWT из cookie)."
					}
				},
				{
					"name": "Update Profile",
					"request": {
						"method": "PATCH",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "X-CSRF-Token", "value": "{{csrfToken}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Новое имя\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/profile",
							"host": ["{{baseUrl}}"],
							"path": ["profile"]
						}
					}
				},
				{
					"name": "Upload Avatar",
					"request": {
						"method": "POST",
						"header": [
							{"key": "X-CSRF-Token", "value": "{{csrfToken}}"}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "avatar",
									"type": "file",
									"src": ""
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/profile/avatar",
							"host": ["{{baseUrl}}"],
							"path": ["profile", "avatar"]
						},
						"description": "JPEG/PNG/WebP/GIF, max 5MB."
					}
				},
				{
					"name": "Get Public Profile",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/users/{{userId}}",
							"host": ["{{baseUrl}}"],
							"path": ["users", "{{userId}}"]
						},
						"description": "Публичный профиль (без авторизации). Имя, аватар, рейтинг, кол-во объявлений."
					}
				}
			]
		},
